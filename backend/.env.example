# HandyNaija Backend Environment Configuration Template

# General Application Settings
PROJECT_NAME="HandyNaija API"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_password"
POSTGRES_DB="handynaija_mvp"

# Complete SQLAlchemy Database URI (Optional override; auto-computed if omitted)
# SQLALCHEMY_DATABASE_URI="postgresql://postgres:your_secure_password@localhost:5432/handynaija_mvp"

# Security & JWT Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY="your_super_secret_jwt_key_here_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days for MVP session convenience

# CORS Origins (JSON list of allowed frontend origins)
BACKEND_CORS_ORIGINS='["http://localhost", "http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "http://127.0.0.1:5500", "http://localhost:5500"]'

# First Superuser / Admin Seed (Optional)
FIRST_SUPERUSER_EMAIL="admin@handynaija.ng"
FIRST_SUPERUSER_PASSWORD="ChangeMe123!"
